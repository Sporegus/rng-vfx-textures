{
  "name": "zin",
  "productName": "Zin",
  "version": "0.1.0",
  "description": "Zin - a little desktop buddy that lives on your screen and helps out.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zin.desktop",
    "productName": "Zin",
    "files": ["main.js", "preload.js", "actions/**", "brain/intents.js", "brain/brain.js", "src/**", "assets/**"],
    "win": { "icon": "assets/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
